{
    "version":  2,
    "outputDirectory":  "web",
    "functions":  {
                      "api/*.js":  {
                                       "maxDuration":  20
                                   }
                  },
    "rewrites":  [
                     {
                         "source":  "/",
                         "destination":  "/index.html"
                     }
                 ],
    "buildCommand":  "npm run db:migrate \u0026\u0026 node scripts/prepare-download.mjs",
    "headers":  [
                    {
                        "headers":  [
                                        {
                                            "key":  "Content-Type",
                                            "value":  "application/vnd.android.package-archive"
                                        },
                                        {
                                            "key":  "Content-Disposition",
                                            "value":  "attachment; filename=\"Boundary-Android-arm64.apk\""
                                        },
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=0, must-revalidate"
                                        },
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        }
                                    ],
                        "source":  "/downloads/Boundary-Android-arm64.apk"
                    }
                ]
}