<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="boundary.db" />
        <include domain="sharedpref" path="MainActivity.xml" />
        <include domain="sharedpref" path="official-access.xml" />
        <include domain="sharedpref" path="publication.xml" />
        <include domain="file" path="scorebooks/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="boundary.db" />
        <include domain="sharedpref" path="MainActivity.xml" />
        <include domain="sharedpref" path="official-access.xml" />
        <include domain="sharedpref" path="publication.xml" />
        <include domain="file" path="scorebooks/" />
    </device-transfer>
</data-extraction-rules>
